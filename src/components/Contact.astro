---
const { 
  title = "Контактная информация",
  subtitle = "Чтобы узнать больше про наши растения или договориться о встрече, напишите нам!",
  address = "Vadul lui Vodă, Piața Agricola",
  mobile = "069-60-70-72",
  phone = "022-49-60-89",
  email = "barbaroshka@rambler.ru"
} = Astro.props;
---

<section id="contact" class="section p-8 mb-8 grid grid-cols-1 gap-8 items-start md:grid-cols-2">
  <div class="contact-content">
    <h2 class="section-title text-3xl mb-4 text-[var(--color-primary)]">{title}</h2>
    <p class="section-subtitle text-[var(--color-text-light)] mb-8 text-base">{subtitle}
    </p>
    <div class="contact-info">
      <p class="mb-3 text-[var(--color-text-light)]"><span class="mb-3 text-[var(--color-primary)]">Адрес:</span> {address}</p>
      <p class="mb-3 text-[var(--color-text-light)]"><span class="mb-3 text-[var(--color-primary)]">Мобильный телефон: </span>{mobile}</p>
      <p class="mb-3 text-[var(--color-text-light)]"><span class="mb-3 text-[var(--color-primary)]">Городской телефон: </span>{phone}</p>
      <p class="mb-3 text-[var(--color-text-light)]"><span class="mb-3 text-[var(--color-primary)]">Эл. Почта: </span>{email}</p>
    </div>
  </div>
  <div class="map">
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d2716.5968781259294!2d29.0815239!3d47.0873684!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x40c965935a595cff%3A0x9962e5cc16168968!2sPiata%20Agricola!5e0!3m2!1sru!2s!4v1771776578287!5m2!1sru!2s"
      width="400" height="300" style="border:0" allowfullscreen="" loading="lazy"
      referrerpolicy="no-referrer-when-downgrade" class="w-full h-[350px] rounded-[16px]"></iframe>
  </div>
</section>
